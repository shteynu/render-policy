{
  "name": "mcp-app-lint",
  "version": "0.1.6",
  "description": "SARIF findings about what an MCP App declares (CSP domain lists, permissions, tool visibility) and what its HTML does (innerHTML sinks, postMessage to '*', external hosts, data sinks); A2UI message streams (openUrl schemes, sink hosts, data in URLs, markup in Text).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-app-lint": "./bin/mcp-app-lint.mjs"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p test/types/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@render-policy/core": "^0.1.4",
    "eslint": "^10.11.0",
    "eslint-plugin-render-policy": "^0.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "a2ui",
    "sarif",
    "security",
    "csp",
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shteynu/render-policy.git",
    "directory": "packages/mcp-app-lint"
  }
}
