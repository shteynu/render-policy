{
  "name": "@render-policy/react",
  "version": "0.1.5",
  "description": "React adapter for @render-policy/core: render agent Markdown/HTML into a ref without dangerouslySetInnerHTML, with a streaming mode; A2UI Text and Image components under @render-policy/react/a2ui.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./a2ui": {
      "types": "./dist/a2ui/index.d.ts",
      "import": "./dist/a2ui/index.js",
      "default": "./dist/a2ui/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@render-policy/a2ui": "^0.1.5",
    "@render-policy/core": "^0.1.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@render-policy/a2ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@render-policy/a2ui": "^0.1.5",
    "@render-policy/core": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "sanitize",
    "xss",
    "markdown",
    "llm",
    "agent",
    "streaming",
    "a2ui",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shteynu/render-policy.git",
    "directory": "packages/react"
  }
}
