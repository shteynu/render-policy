{
  "name": "@render-policy/angular",
  "version": "0.1.4",
  "description": "Angular adapter for @render-policy/core: [rpRender] directive and <rp-markdown> component that render agent content without [innerHTML] or bypassSecurityTrustHtml.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@render-policy/core": "^0.1.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@render-policy/core": "^0.1.0",
    "ng-packagr": "^22.2.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "angular",
    "sanitize",
    "xss",
    "markdown",
    "llm",
    "agent",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shteynu/render-policy.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
